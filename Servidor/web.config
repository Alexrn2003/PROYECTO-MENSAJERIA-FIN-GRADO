<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- ====================================================================
         CONFIGURACIÓN IIS PARA EASYCOM (PROXY INVERSO HTTPS)
         
         Este archivo se debe copiar a la raíz del sitio en IIS
         Típicamente: C:\inetpub\wwwroot\easycom\web.config
         ==================================================================== -->
    
    <system.webServer>
        <!-- ================================================================
             MÓDULO DE REESCRITURA DE URLS (URL Rewrite)
             Actúa como proxy inverso dirigiendo tráfico al servidor Flask
             ================================================================ -->
        <rewrite>
            <rules>
                <!-- REGLA 1: Redireccionar HTTP a HTTPS (seguridad) -->
                <rule name="Force HTTPS" stopProcessing="true">
                    <match url="(.*)" />
                    <conditions>
                        <add input="{HTTPS}" pattern="^OFF$" />
                        <!-- No redireccionar .well-known (Let's Encrypt) -->
                        <add input="{REQUEST_URI}" pattern="^/.well-known/" negate="true" />
                    </conditions>
                    <action type="Redirect" url="https://{HTTP_HOST}{REQUEST_URI}" redirectType="Permanent" />
                </rule>
                
                <!-- REGLA 2: Proxy Inverso al servidor Flask -->
                <rule name="ProxyToFlask" stopProcessing="true">
                    <match url="(.*)" />
                    <action type="Rewrite" url="http://localhost:5000/{R:1}" appendQueryString="true" />
                </rule>
            </rules>
            
            <!-- Variables de servidor para proxy reverso -->
            <serverVariables>
                <!-- Informar al servidor backend sobre el cliente original -->
                <set name="HTTP_X_FORWARDED_FOR" value="{REMOTE_ADDR}" />
                
                <!-- Protocolo original (https) -->
                <set name="HTTP_X_FORWARDED_PROTO" value="https" />
                
                <!-- Host original -->
                <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
                
                <!-- Puerto original -->
                <set name="HTTP_X_FORWARDED_PORT" value="{SERVER_PORT}" />
            </serverVariables>
        </rewrite>
        
        <!-- ================================================================
             SOPORTE PARA WEBSOCKET (WebSocket)
             Necesario para Socket.IO en el chat en tiempo real
             ================================================================ -->
        <webSocket enabled="true" />
        
        <!-- ================================================================
             PROXY (Application Request Routing)
             Requiere ARR instalado
             ================================================================ -->
        <proxy enabled="true" />
        
        <!-- ================================================================
             COMPRESIÓN (Mejora de rendimiento)
             ================================================================ -->
        <urlCompression doDynamicCompression="true" doStaticCompression="true" />
        
        <!-- ================================================================
             ALMACENAMIENTO EN CACHÉ (Caching)
             ================================================================ -->
        <caching enabled="true">
            <!-- No cachear respuestas dinámicas -->
            <profiles>
                <add extension=".html" policy="DisableCache" kernelCachePolicy="DisableCache" />
                <add extension=".js" policy="CacheForTimePeriod" duration="01:00:00" kernelCachePolicy="CacheForTimePeriod" duration="01:00:00" />
                <add extension=".css" policy="CacheForTimePeriod" duration="01:00:00" kernelCachePolicy="CacheForTimePeriod" duration="01:00:00" />
            </profiles>
        </caching>
        
        <!-- ================================================================
             SEGURIDAD - Filtrado de Solicitudes
             ================================================================ -->
        <security>
            <requestFiltering>
                <!-- Bloquear acceso a ficheros Python (no deben ser públicos) -->
                <fileExtensions>
                    <add fileExtension=".py" allowed="false" />
                    <add fileExtension=".pyc" allowed="false" />
                    <add fileExtension=".pyo" allowed="false" />
                    <add fileExtension=".env" allowed="false" />
                </fileExtensions>
                
                <!-- Bloquear directorios peligrosos -->
                <hiddenSegments>
                    <add segment="__pycache__" />
                    <add segment=".git" />
                    <add segment=".env" />
                </hiddenSegments>
            </requestFiltering>
            
            <!-- Encabezados de seguridad HTTP -->
            <httpResponseHeaders>
                <!-- Evitar clickjacking -->
                <add name="X-Frame-Options" value="DENY" />
                
                <!-- Evitar MIME-sniffing -->
                <add name="X-Content-Type-Options" value="nosniff" />
                
                <!-- XSS Protection (antiguos navegadores) -->
                <add name="X-XSS-Protection" value="1; mode=block" />
                
                <!-- Content Security Policy -->
                <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline';" />
                
                <!-- HSTS (HTTP Strict Transport Security) -->
                <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
                
                <!-- Referrer Policy -->
                <add name="Referrer-Policy" value="no-referrer-when-downgrade" />
                
                <!-- Información del servidor (ocultar) -->
                <add name="Server" value="Application Server" />
            </httpResponseHeaders>
        </security>
        
        <!-- ================================================================
             MANEJO DE ERRORES (Error Handling)
             ================================================================ -->
        <httpErrors>
            <!-- Errores personalizados -->
            <error statusCode="404" path="/404.html" />
            <error statusCode="500" path="/500.html" />
        </httpErrors>
        
        <!-- ================================================================
             LÍMITES PREDETERMINADOS (Defaults)
             ================================================================ -->
        <defaultDocument>
            <files>
                <!-- No servir archivos específicos por defecto -->
                <add value="index.html" />
            </files>
        </defaultDocument>
        
        <!-- ================================================================
             MÓDULOS (Modules)
             Instala solo los necesarios
             ================================================================ -->
        <modules>
            <!-- Required modules for proxy -->
            <add name="IISWebSocketModule" image="%windir%\System32\iiswsock.dll" preCondition="bitness32" />
        </modules>
    </system.webServer>
    
    <!-- ====================================================================
         CONFIGURACIÓN DEL SERVIDOR (AppHost)
         ===================================================================== -->
    <appSettings>
        <!-- Variables de aplicación -->
        <add key="Backend_URL" value="http://localhost:5000" />
        <add key="Domain" value="easycom.local" />
    </appSettings>
    
    <!-- ====================================================================
         NOTAS DE CONFIGURACIÓN:
         
         1. WEBSOCKET:
            - SocketIO requiere WebSocket para chat en tiempo real
            - Asegurate de que <webSocket enabled="true" />
         
         2. PROXY_REVERSO:
            - El servidor Flask corre internamente en puerto 5000
            - IIS expone HTTPS en puerto 443 hacia clientes externos
            - Las peticiones se reescriben internamente a http://localhost:5000
         
         3. HEADERS_PROXY:
            - X-Forwarded-For: IP del cliente real (no de IIS)
            - X-Forwarded-Proto: Protocolo original (https)
            - Se necesitan en Flask para funcionalidad correcta
         
         4. COMPRESIÓN:
            - Mejora rendimiento comprimiendo respuestas
            - Soporta gzip y deflate
         
         5. SEGURIDAD:
            - Bloquea acceso a archivos .py, .env, __pycache__
            - Añade headers HTTP modernos (HSTS, CSP, X-Frame-Options)
            - Oculta información del servidor
         
         ==================================================================== -->
</configuration>
